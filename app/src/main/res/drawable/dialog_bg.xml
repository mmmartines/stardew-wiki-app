<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- moldura externa de madeira escura -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="10dp" />
            <solid android:color="@color/wood_dark" />
        </shape>
    </item>
    <!-- borda de madeira clara -->
    <item android:left="4dp" android:top="4dp" android:right="4dp" android:bottom="4dp">
        <shape android:shape="rectangle">
            <corners android:radius="7dp" />
            <solid android:color="@color/wood" />
        </shape>
    </item>
    <!-- pergaminho -->
    <item android:left="7dp" android:top="7dp" android:right="7dp" android:bottom="7dp">
        <shape android:shape="rectangle">
            <corners android:radius="5dp" />
            <solid android:color="@color/parchment" />
        </shape>
    </item>
</layer-list>
